# OptiWMS Infrastructure Environment Template
# Copy this to .env and fill in your actual values

# Database Configuration
POSTGRES_DB=optiwms
POSTGRES_USER=optiwms
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Database URLs (for applications)
DATABASE_URL=postgresql://optiwms:your_secure_password_here@localhost:5434/optiwms

# Service Ports
CORE_API_PORT=8080
FRONTEND_PORT=3000
FORECAST_SERVICE_PORT=8091
ORCHESTRATOR_SERVICE_PORT=8092

# External Service URLs
WMS_API_BASE_URL=http://localhost:8080/api
FORECAST_API_BASE_URL=http://localhost:8091

# Security
JWT_SECRET=your_jwt_secret_key_here
WMS_SERVICE_TOKEN=your_service_token_here

# Email Configuration (if needed)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_email_password

# Monitoring & Alerting
OPS_ALERT_WEBHOOK_URL=https://your-slack-webhook-url
OPS_ALERT_MIN_STATUS=warn

# Development Settings
DEBUG=true
LOG_LEVEL=INFO

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30