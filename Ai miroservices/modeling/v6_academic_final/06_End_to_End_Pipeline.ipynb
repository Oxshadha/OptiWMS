   "source": [
    "# 6.1 Prepare slotting inputs (heuristic baseline + GA research layer)\n",
    "ga_items = sku_profile[sku_profile['forecast_p50'].notna()].copy()\n",
    "ga_items = ga_items[ga_items['storage_type'].notna()].drop_duplicates(subset=['fg_code'])\n",
    "assert ga_items['fg_code'].nunique() == len(ga_items)\n",
    "\n",
    "zone_priority = {'FA': 1, 'FB': 2, 'FC': 3, 'MA': 4, 'MB': 5, 'MC': 6, 'SA': 7, 'SB': 8, 'SC': 9}\n",
    "ga_items['zone_priority'] = ga_items['zone'].map(zone_priority)\n",
    "\n",
    "# 6.1a Operational heuristic (production-style) \u2014 sort by zone priority, assign sequential locations\n",
    "heuristic_sorted = ga_items.sort_values(['zone_priority', 'forecast_p50'], ascending=[True, False])\n",
    "heuristic_assignment = list(range(len(heuristic_sorted)))\n",
    "heuristic_sorted = heuristic_sorted.copy()\n",
    "heuristic_sorted['heuristic_loc'] = heuristic_assignment\n",
    "\n",
    "print(f'=== Slotting Inputs ===')\n",
    "print(f'Unique FG SKUs: {len(ga_items)}')\n",
    "print(f'Rack locations: {len(rack_locs)}')\n",
    "print(f'Heuristic baseline: ABC-FMS zone-priority assignment (stable, deterministic)')\n"
   ]
