    "# 6.5 Slotting method comparison (shared objective)\n",
    "def slotting_objective(assign, items_array, n_locs, incumbent=None, stability_lambda=0.0):\n",
    "    score = 0.0\n",
    "    for i, loc_idx in enumerate(assign):\n",
    "        zone_prio = items_array[i, 0]\n",
    "        loc_rank = loc_idx / max(n_locs, 1)\n",
    "        score += abs(zone_prio / 9.0 - loc_rank) * items_array[i, 2]\n",
    "        if items_array[i, 1] > 50 and loc_rank > 0.5:\n",
    "            score += items_array[i, 1] * 0.1\n",
    "        if incumbent is not None:\n",
    "            score += stability_lambda * abs(loc_idx - incumbent[i])\n",
    "    return score\n",
    "\n",
    "# Full GA demo set\n",
    "heur_full = list(incumbent[:len(ga_items_ga)])\n",
    "ga_full = list(best_ind[:len(ga_items_ga)])\n",
    "cost_heur = slotting_objective(heur_full, items_array, n_locs)\n",
    "cost_ga = slotting_objective(ga_full, items_array, n_locs, incumbent=heur_full, stability_lambda=STABILITY_LAMBDA)\n",
    "reloc_ga = sum(a != b for a, b in zip(ga_full, heur_full))\n",
    "\n",
    "# MILP subset (apples-to-apples)\n",
    "sub_items = sub[['zone_priority', 'weight_kg', 'forecast_p50', 'forecast_spread']].fillna(0).values\n",
    "sub_heur = heuristic_sorted.set_index('fg_code').loc[sub['fg_code'], 'heuristic_loc'].tolist()\n",
    "code_to_ga = dict(zip(ga_items_ga['fg_code'], ga_full))\n",
    "sub_ga = [code_to_ga[c] for c in sub['fg_code']]\n",
    "cost_milp = slotting_objective(milp_assign, sub_items, N_LOC)\n",
    "cost_heur_sub = slotting_objective(sub_heur, sub_items, N_LOC)\n",
    "cost_ga_sub = slotting_objective(sub_ga, sub_items, N_LOC, incumbent=sub_heur, stability_lambda=STABILITY_LAMBDA)\n",
    "reloc_milp = sum(a != b for a, b in zip(milp_assign, sub_heur))\n",
    "reloc_ga_sub = sum(a != b for a, b in zip(sub_ga, sub_heur))\n",
