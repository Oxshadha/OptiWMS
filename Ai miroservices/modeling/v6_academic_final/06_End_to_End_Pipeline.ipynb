  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6.2 GA Optimisation (research demo \u2014 NOT weekly production replanning)\n",
    "if not HAS_DEAP:\n",
    "    raise ImportError('DEAP not loaded. Re-run cell 1.')\n",
    "\n",
    "np.random.seed(SEED)\n",
    "n_items = len(ga_items)\n",
    "n_locations = len(rack_locs)\n",
    "ga_items_ga = ga_items.copy()\n",
    "incumbent = heuristic_sorted.set_index('fg_code')['heuristic_loc'].reindex(ga_items_ga['fg_code']).fillna(0).astype(int).tolist()\n",
    "STABILITY_LAMBDA = 0.15  # penalty for moving from heuristic layout\n",
    "\n",
    "DEMO_MAX_ITEMS = 120\n",
    "if n_items > DEMO_MAX_ITEMS:\n",
    "    top_codes = ga_items.nlargest(DEMO_MAX_ITEMS, 'forecast_p50')['fg_code']\n",
    "    ga_items_ga = ga_items[ga_items['fg_code'].isin(top_codes)].copy()\n",
    "    incumbent = heuristic_sorted[heuristic_sorted['fg_code'].isin(top_codes)]['heuristic_loc'].tolist()\n",
    "    n_items = len(ga_items_ga)\n",
    "\n",
    "items_array = ga_items_ga[['zone_priority', 'weight_kg', 'forecast_p50', 'forecast_spread']].fillna(0).values\n",
    "n_locs = n_locations\n",
    "print(f'  GA demo: {n_items} items -> {n_locs} locations (seed={SEED})')\n",
    "\n",
    "if hasattr(creator, 'FitnessMin'): del creator.FitnessMin\n",
    "if hasattr(creator, 'Individual'): del creator.Individual\n",
    "creator.create('FitnessMin', base.Fitness, weights=(-1.0,))\n",
    "creator.create('Individual', list, fitness=creator.FitnessMin)\n",
    "\n",
    "toolbox = base.Toolbox()\n",
    "toolbox.register('individual', tools.initIterate, creator.Individual,\n",
    "                 lambda: list(np.random.randint(0, n_locs, size=n_items)))\n",
    "toolbox.register('population', tools.initRepeat, list, toolbox.individual)\n",
    "\n",
    "def evaluate(individual):\n",
    "    score = 0.0\n",
    "    for i, loc_idx in enumerate(individual):\n",
    "        zone_prio = items_array[i, 0]\n",
    "        loc_rank = loc_idx / max(n_locs, 1)\n",
    "        score += abs(zone_prio / 9.0 - loc_rank) * items_array[i, 2]\n",
    "        if items_array[i, 1] > 50 and loc_rank > 0.5:\n",
    "            score += items_array[i, 1] * 0.1\n",
    "        score += STABILITY_LAMBDA * abs(loc_idx - incumbent[i])\n",
    "    return (score,)\n",
    "\n",
    "toolbox.register('evaluate', evaluate)\n",
    "toolbox.register('mate', tools.cxTwoPoint)\n",
    "toolbox.register('mutate', tools.mutUniformInt, low=0, up=n_locs, indpb=0.05)\n",
    "toolbox.register('select', tools.selTournament, tournsize=3)\n",
    "\n",
    "def run_ga(seed):\n",
    "    np.random.seed(seed)\n",
    "    pop = toolbox.population(n=100)\n",
    "    NGEN = 50\n",
    "    hist = []\n",
    "    for gen in range(NGEN):\n",
    "        offspring = algorithms.varAnd(pop, toolbox, cxpb=0.7, mutpb=0.2)\n",
    "        for ind, fit in zip(offspring, map(toolbox.evaluate, offspring)):\n",
    "            ind.fitness.values = fit\n",
    "        pop = toolbox.select(offspring, k=len(pop))\n",
    "        hist.append(min(ind.fitness.values[0] for ind in pop))\n",
    "    return tools.selBest(pop, 1)[0], hist\n",
    "\n",
    "best_ind, fitness_history = run_ga(SEED)\n",
    "NGEN = 50\n",
    "print(f'  Final fitness: {best_ind.fitness.values[0]:.2f}')\n",
    "\n",
    "# Stability experiment: same data, different seed\n",
    "best_ind_b, _ = run_ga(SEED + 1)\n",
    "moved_a = sum(a != b for a, b in zip(best_ind, incumbent))\n",
    "moved_b = sum(a != b for a, b in zip(best_ind_b, best_ind))\n",
    "print(f'  GA vs heuristic relocations: {moved_a}/{n_items} ({100*moved_a/n_items:.0f}%)')\n",
    "print(f'  GA rerun (seed+1) relocations vs first GA: {moved_b}/{n_items} ({100*moved_b/n_items:.0f}%)')\n",
    "print('  -> Heuristic is stable; GA is stochastic \u2014 use heuristic for operations')\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 5))\n",
    "ax.plot(fitness_history, 'b-', linewidth=2)\n",
    "ax.set_xlabel('Generation')\n",
    "ax.set_ylabel('Best Fitness (lower = better)')\n",
    "ax.set_title('GA Convergence (research demo \u2014 advisory only)')\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
