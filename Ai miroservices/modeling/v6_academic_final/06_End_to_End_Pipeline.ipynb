    "bom_exploded['rm_gross_p50'] = bom_exploded['forecast_p50'] * bom_exploded[qty_col] / yield_mean\n",
    "bom_exploded['rm_gross_p90'] = bom_exploded['forecast_p90'] * bom_exploded[qty_col] / yield_pess\n",
    "bom_exploded['rm_gross_p10'] = bom_exploded['forecast_p10'] * bom_exploded[qty_col] / yield_mean\n",
