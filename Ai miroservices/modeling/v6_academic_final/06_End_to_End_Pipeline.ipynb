    "## Step 5: Inventory Policy Calculation\n",
    "\n",
    "Using quantile forecasts to calculate **Safety Stock**, **Reorder Point (ROP)**, and **Max Stock** for each SKU."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5.1 Inventory policy \u2014 combined demand + lead-time uncertainty\n",
    "SERVICE_LEVEL_Z = 1.65  # 95%\n",
    "REVIEW_PERIOD_DAYS = 30\n",
    "\n",
    "sku_profile['forecast_std'] = (sku_profile['forecast_p90'] - sku_profile['forecast_p10']) / (2 * 1.28)\n",
    "sku_profile['lead_time_months'] = sku_profile['lead_time_mean'] / 30.0\n",
    "sku_profile['lead_time_std_months'] = sku_profile['lead_time_std'].fillna(3) / 30.0\n",
    "\n",
    "d_bar = sku_profile['forecast_p50'].fillna(0)\n",
    "sigma_d = sku_profile['forecast_std'].fillna(0)\n",
    "L = sku_profile['lead_time_months']\n",
    "sigma_L = sku_profile['lead_time_std_months']\n",
    "\n",
    "# SS = z * sqrt(L * sigma_d^2 + d_bar^2 * sigma_L^2)\n",
    "sku_profile['safety_stock'] = SERVICE_LEVEL_Z * np.sqrt(\n",
    "    L * sigma_d**2 + d_bar**2 * sigma_L**2)\n",
    "sku_profile['rop'] = d_bar * L + sku_profile['safety_stock']\n",
    "sku_profile['max_stock'] = sku_profile['forecast_p90'] * (L + 1) + sku_profile['safety_stock']\n",
    "sku_profile['order_qty'] = sku_profile['max_stock'] - sku_profile['rop']\n",
    "\n",
    "# Supply-chain stress (2020–2026): wars, port delays, sanctions — inflate LT volatility, NOT demand forecast\n",
    "LT_STRESS_MULT = 1.5  # e.g. 50% higher lead-time uncertainty under disruption\n",
    "sigma_L_stress = sigma_L * LT_STRESS_MULT\n",
    "sku_profile['safety_stock_stress'] = SERVICE_LEVEL_Z * np.sqrt(\n",
    "    L * sigma_d**2 + d_bar**2 * sigma_L_stress**2)\n",
    "sku_profile['rop_stress'] = d_bar * L + sku_profile['safety_stock_stress']\n",
    "\n",
    "print('=== Inventory Policy (FG) — probabilistic lead times ===')\n",
    "print('Demand forecast unchanged; safety stock reacts to LT volatility (correct layer).')\n",
    "print(f'Lead time: per-SKU mean {sku_profile[\"lead_time_mean\"].mean():.1f}d (not global 14d)')\n",
    "print(f'Avg safety stock baseline vs stress (LT x{LT_STRESS_MULT}): '\n",
    "      f'{sku_profile[\"safety_stock\"].mean():.0f} -> {sku_profile[\"safety_stock_stress\"].mean():.0f} units')\n",
    "inv_summary = sku_profile.groupby('abc_class').agg(\n",
    "    avg_safety=('safety_stock', 'mean'), avg_rop=('rop', 'mean'),\n",
    "    total_safety=('safety_stock', 'sum'), n_skus=('fg_code', 'count')).reindex(['A', 'B', 'C'])\n",
    "print(inv_summary.round(0))\n",
    "\n",
    "# Sensitivity: LT volatility vs demand volatility\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "lt_cv = np.linspace(0, 0.5, 20)\n",
    "d_fixed, sd_fixed, L_fixed = 1000, 200, 14/30\n",
    "ss_d_only = SERVICE_LEVEL_Z * sd_fixed * np.sqrt(L_fixed)\n",
    "ss_combined = SERVICE_LEVEL_Z * np.sqrt(L_fixed * sd_fixed**2 + (d_fixed * lt_cv * L_fixed)**2)\n",
    "ax.plot(lt_cv, ss_combined, 'r-', label='Combined demand + LT uncertainty')\n",
    "ax.axhline(ss_d_only, color='b', linestyle='--', label='Demand-only (static LT)')\n",
    "ax.set_xlabel('Lead-time coefficient of variation')\n",
    "ax.set_ylabel('Safety stock (illustrative)')\n",
    "ax.set_title('LT volatility in safety stock (2020–2026 disruptions — inventory layer, not demand model)')\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
