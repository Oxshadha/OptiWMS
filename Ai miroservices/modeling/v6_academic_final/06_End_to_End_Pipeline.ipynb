  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6.4 MILP demo (PuLP) \u2014 deterministic slotting for top A-class SKUs\n",
    "try:\n",
    "    import pulp\n",
    "    HAS_PULP = True\n",
    "except ImportError:\n",
    "    import subprocess, sys\n",
    "    subprocess.check_call([sys.executable, '-m', 'pip', 'install', 'pulp>=2.8.0', '-q'])\n",
    "    import pulp\n",
    "    HAS_PULP = True\n",
    "\n",
    "N_SKU = min(20, len(ga_items_ga))\n",
    "N_LOC = min(40, len(rack_locs))\n",
    "sub = ga_items_ga.nlargest(N_SKU, 'forecast_p50').reset_index(drop=True)\n",
    "\n",
    "prob = pulp.LpProblem('slotting_milp', pulp.LpMinimize)\n",
    "x = pulp.LpVariable.dicts('assign', ((i, j) for i in range(N_SKU) for j in range(N_LOC)), cat='Binary')\n",
    "# Each SKU to exactly one location\n",
    "for i in range(N_SKU):\n",
    "    prob += pulp.lpSum(x[i, j] for j in range(N_LOC)) == 1\n",
    "# Each location at most one SKU (simplified)\n",
    "for j in range(N_LOC):\n",
    "    prob += pulp.lpSum(x[i, j] for i in range(N_SKU)) <= 1\n",
    "\n",
    "# Minimise zone mismatch cost\n",
    "cost = []\n",
    "for i in range(N_SKU):\n",
    "    zp = sub.loc[i, 'zone_priority']\n",
    "    for j in range(N_LOC):\n",
    "        loc_rank = j / max(N_LOC, 1)\n",
    "        cost.append(abs(zp / 9.0 - loc_rank) * sub.loc[i, 'forecast_p50'] * x[i, j])\n",
    "prob += pulp.lpSum(cost)\n",
    "prob.solve(pulp.PULP_CBC_CMD(msg=0))\n",
    "\n",
    "milp_assign = []\n",
    "for i in range(N_SKU):\n",
    "    for j in range(N_LOC):\n",
    "        if pulp.value(x[i, j]) == 1:\n",
    "            milp_assign.append(j)\n",
    "            break\n",
    "print(f'MILP solved: {N_SKU} A-class SKUs -> {N_LOC} locations (deterministic)')\n",
    "sub_incumbent = heuristic_sorted.set_index('fg_code').loc[sub['fg_code'], 'heuristic_loc'].tolist()\n",
    "print(f'MILP relocations vs heuristic: {sum(a!=b for a,b in zip(milp_assign, sub_incumbent))}/{N_SKU}')\n"
