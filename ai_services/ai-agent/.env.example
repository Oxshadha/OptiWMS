GOOGLE_API_KEY="Your Key"
AI_AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Fallback model provider. Used automatically when Gemini returns a quota or
# rate-limit error. Without it, a Gemini 429 surfaces as "AI quota exceeded".
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Spring identity + guard rails. The agent validates every bearer token against
# this base URL and rejects unauthenticated callers.
SPRING_API_BASE_URL=http://localhost:8080
AI_AGENT_RATE_LIMIT_PER_MINUTE=30

# Roles permitted to run generated SQL through the analytics tool.
AI_AGENT_SQL_ROLES=ADMIN,MANAGER

# Warehouse database, used by the analytics + reporting tools.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=optiwms
DB_USER=optiwms
DB_PASSWORD=optiwms

# Forecast-service base URL. Required for the "why is demand high/low" answers:
# the assistant fetches pre-computed SHAP attributions from here. When unset the
# assistant still replies, but silently without any model explanation.
FORECAST_SERVICE_BASE=http://127.0.0.1:8091
