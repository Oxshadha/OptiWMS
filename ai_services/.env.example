RETENTION_MAX_RUN_AGE_DAYS=45
INFERENCE_AUDIT_MAX_LINES=10000
HEALTH_MONITOR_INTERVAL_SECONDS=120
FRESHNESS_MAX_AGE_MINUTES=180
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_MIN_STATUS=warn
OPS_ALERT_INCLUDE_DETAILS=true
GOVERNANCE_ENABLED=false
