NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WAREHOUSE_AI_URL=http://localhost:8094/ask

# AI microservices (slotting GA engine, forecasting, etc.)
# Used by the admin AI-slotting page only. Ordering and worker flows read stored
# slotting plans from the database instead, so they work without this service.
# The slotting service listens on 8093 (see ai_services/slotting-service/Dockerfile).
NEXT_PUBLIC_AI_SERVICES_URL=http://localhost:8093/api/v1
NEXT_PUBLIC_BUILD_COMMIT=development
NEXT_PUBLIC_DATASET_VERSION=PROJECT_OPS_RM_PM
NEXT_PUBLIC_FORECAST_DEPLOYED_DATASET=PROJECT_OPS_RM_PM
NEXT_PUBLIC_FORECAST_DEPLOYED_MODEL=PROJECT_OPS_EXTRA_TREES_CAUSAL
