{
  "info": {
    "_postman_id": "path-optimization-api",
    "name": "Path Optimization Service",
    "description": "Complete API collection for warehouse pathfinding service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & Info",
      "item": [
        {
          "name": "Service Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Get service information and endpoints"
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/",
              "host": ["{{base_url}}"],
              "path": ["health", ""]
            }
          }
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/readiness",
              "host": ["{{base_url}}"],
              "path": ["health", "readiness"]
            }
          }
        },
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/liveness",
              "host": ["{{base_url}}"],
              "path": ["health", "liveness"]
            }
          }
        },
        {
          "name": "Service Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/pathfinding/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "pathfinding", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "Pathfinding - Single",
      "item": [
        {
          "name": "Simple Path (Entry to Rack A1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"ENTRY\",\n  \"end\": \"AISLE_1_A\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pathfinding/optimize",
              "host": ["{{base_url}}"],
              "path": ["api", "pathfinding", "optimize"]
            },
            "description": "Find simple path from entry to first rack"
          }
        },
        {
          "name": "Complex Path (Entry to Far End)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"ENTRY\",\n  \"end\": \"AISLE_3_D\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pathfinding/optimize",
              "host": ["{{base_url}}"],
              "path": ["api", "pathfinding", "optimize"]
            }
          }
        },
        {
          "name": "Path with Constraints",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"ENTRY\",\n  \"end\": \"AISLE_2_C\",\n  \"constraints\": {\n    \"worker_type\": \"picker\",\n    \"avoid_congestion\": true,\n    \"avoid_narrow_aisles\": false\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pathfinding/optimize",
              "host": ["{{base_url}}"],
              "path": ["api", "pathfinding", "optimize"]
            }
          }
        },
        {
          "name": "Path for Forklift",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"ENTRY\",\n  \"end\": \"AISLE_2_B\",\n  \"constraints\": {\n    \"worker_type\": \"forklift\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pathfinding/optimize",
              "host": ["{{base_url}}"],
              "path": ["api", "pathfinding", "optimize"]
            }
          }
        },
        {
          "name": "Legacy Endpoint (find-path)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"ENTRY\",\n  \"end\": \"AISLE_1_C\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pathfinding/find-path",
              "host": ["{{base_url}}"],
              "path": ["api", "pathfinding", "find-path"]
            }
          }
        }
      ]
    },
    {
      "name": "Pathfinding - Batch",
      "item": [
        {
          "name": "Batch: Multi-Stop Picking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requests\": [\n    {\n      \"start\": \"ENTRY\",\n      \"end\": \"AISLE_1_A\"\n    },\n    {\n      \"start\": \"AISLE_1_A\",\n      \"end\": \"AISLE_2_C\"\n    },\n    {\n      \"start\": \"AISLE_2_C\",\n      \"end\": \"AISLE_3_D\"\n    },\n    {\n      \"start\": \"AISLE_3_D\",\n      \"end\": \"EXIT\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pathfinding/batch-optimize",
              "host": ["{{base_url}}"],
              "path": ["api", "pathfinding", "batch-optimize"]
            },
            "description": "Optimize multiple paths for a picking list"
          }
        },
        {
          "name": "Batch: 10 Paths",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requests\": [\n    {\"start\": \"ENTRY\", \"end\": \"AISLE_1_A\"},\n    {\"start\": \"AISLE_1_A\", \"end\": \"AISLE_1_B\"},\n    {\"start\": \"AISLE_1_B\", \"end\": \"AISLE_1_C\"},\n    {\"start\": \"AISLE_1_C\", \"end\": \"AISLE_2_A\"},\n    {\"start\": \"AISLE_2_A\", \"end\": \"AISLE_2_B\"},\n    {\"start\": \"AISLE_2_B\", \"end\": \"AISLE_2_C\"},\n    {\"start\": \"AISLE_2_C\", \"end\": \"AISLE_3_A\"},\n    {\"start\": \"AISLE_3_A\", \"end\": \"AISLE_3_C\"},\n    {\"start\": \"AISLE_3_C\", \"end\": \"AISLE_3_D\"},\n    {\"start\": \"AISLE_3_D\", \"end\": \"EXIT\"}\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pathfinding/batch-optimize",
              "host": ["{{base_url}}"],
              "path": ["api", "pathfinding", "batch-optimize"]
            }
          }
        }
      ]
    },
    {
      "name": "Warehouse Configuration",
      "item": [
        {
          "name": "Get Sample Warehouse",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/pathfinding/sample-warehouse",
              "host": ["{{base_url}}"],
              "path": ["api", "pathfinding", "sample-warehouse"]
            },
            "description": "Retrieve the default sample warehouse configuration"
          }
        },
        {
          "name": "Get Warehouse Info (Default)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/pathfinding/warehouse-info",
              "host": ["{{base_url}}"],
              "path": ["api", "pathfinding", "warehouse-info"]
            },
            "description": "Get metadata about default warehouse"
          }
        },
        {
          "name": "Get Warehouse Info (Custom)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouse_config\": {\n    \"nodes\": [\n      {\"id\": \"ENTRY\", \"row\": 0, \"col\": 0, \"type\": \"entry\"},\n      {\"id\": \"A1\", \"row\": 2, \"col\": 2, \"type\": \"rack\"}\n    ],\n    \"edges\": [\n      {\"from\": \"ENTRY\", \"to\": \"A1\", \"cost\": 2.0, \"bidirectional\": true}\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pathfinding/warehouse-info",
              "host": ["{{base_url}}"],
              "path": ["api", "pathfinding", "warehouse-info"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081",
      "type": "string"
    }
  ]
